generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Departamento {
  id        String   @id @default(cuid())
  nome      String   @unique
  senha     String   @default("123456")
  isAdmin   Boolean  @default(false) // TRUE apenas para "Planejamento"
  metas     Meta[]
  acoes     Acao[]
  createdAt DateTime @default(now())
}

model Diretriz {
  id        String     @id @default(cuid())
  titulo    String     @unique
  descricao String     @default("")
  objetivos Objetivo[]
}

model Objetivo {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String   @default("")
  diretrizId  String
  diretriz    Diretriz @relation(fields: [diretrizId], references: [id])
  metas       Meta[]

  @@unique([titulo, diretrizId])
}

model Meta {
  id             String   @id @default(cuid())
  numero         String
  descricao      String
  indicadorNome  String
  unidadeMedida  String
  linhaBaseAno   Int
  linhaBaseValor Float
  metaPlano2029  String
  metaFisica2026 Float

  objetivoId     String
  objetivo       Objetivo @relation(fields: [objetivoId], references: [id])

  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  acoes          Acao[]
  monitoramentos Monitoramento[]

  @@unique([numero, objetivoId, departamentoId])
}

model Acao {
  id             String       @id @default(cuid())
  numeroJson     Int
  descricao      String
  emExecucao     Boolean      @default(false)
  metaId         String
  meta           Meta         @relation(fields: [metaId], references: [id])
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  @@unique([numeroJson, metaId])
}

model Monitoramento {
  id             String   @id @default(cuid())
  quadrimestre   Int      // 1, 2 ou 3
  ano            Int      @default(2026)
  valorRealizado Float?   // Preenchido pelo usuário
  justificativa  String?  // Texto explicativo obrigatório se não atingir a meta
  statusRAG      String   @default("PENDENTE") // "VERDE", "AMARELO", "VERMELHO"
  
  metaId         String
  meta           Meta     @relation(fields: [metaId], references: [id])
  updatedAt      DateTime @updatedAt
  
  @@unique([metaId, quadrimestre, ano]) // Garante apenas 1 registro por período
}